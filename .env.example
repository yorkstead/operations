# Yorkstead Operations Environment Configuration
# Copy to .env.local for local development. Never commit .env.local or real secrets.

# Public browser configuration
NEXT_PUBLIC_APP_NAME=Yorkstead Operations
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only application configuration
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yorkstead_operations_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
BETTER_AUTH_URL=http://localhost:3000

# Server-only S3-compatible private object storage
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=yorkstead-operations-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider-neutral asynchronous dispatch. Keep "database" until the Cloudflare queue and HTTP pull consumer exist.
QUEUE_PROVIDER=database
QUEUE_ACCOUNT_ID=
QUEUE_ID=
QUEUE_API_TOKEN=
