# Yorkstead Operations Environment Configuration
# Copy to .env.local for local development.
# For production Cloud Run deployment, configure variables via Secret Manager and infrastructure/gcp/env.example

# Node Runtime & Role
NODE_ENV=development
RUNTIME_ROLE=web

# Application URLs
NEXT_PUBLIC_APP_NAME="Yorkstead Operations"
NEXT_PUBLIC_APP_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001

# PostgreSQL Database (Neon Serverless PostgreSQL in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yorkstead_operations_dev

# Better Auth Secret (>= 32 characters high-entropy string)
BETTER_AUTH_SECRET=synthetic_local_dev_secret_32_characters_long_min_entropy

# Operator Super-Admin Account Bootstrap
OWNER_EMAIL=brandon@yorkstead.com
OWNER_BOOTSTRAP_TOKEN=synthetic_local_bootstrap_token_change_in_production

# Cloudflare R2 Object Storage (S3-compatible private vault)
# In local development, leaving S3_* unset falls back to the synthetic local vault adapter.
# In production, all 4 S3_* variables are required.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=yorkstead-operations-private
# S3_ACCESS_KEY_ID=sample_r2_access_key_id
# S3_SECRET_ACCESS_KEY=sample_r2_secret_access_key

# Asynchronous Job Queue (database | cloudflare)
QUEUE_PROVIDER=database
# QUEUE_ACCOUNT_ID=sample_cloudflare_account_id
# QUEUE_ID=sample_queue_id
# QUEUE_API_TOKEN=sample_queue_api_token
