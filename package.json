{
  "name": "@yorkstead/operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yorkstead-Systems/yorkstead.git",
    "directory": "apps/operations"
  },
  "homepage": "https://yorkstead.com",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:integration": "bun test ./tests/database/identity-repository.integration.ts",
    "auth:migrate": "bun x auth@1.7.1 migrate --yes",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:check": "bun scripts/migrate.ts --check-files",
    "db:migrate:check-files": "bun scripts/migrate.ts --check-files",
    "db:migrate:check-live": "bun scripts/migrate.ts --check-live",
    "storage:migrate": "bun scripts/migrate-object-storage.ts",
    "jobs:run": "bun scripts/run-background-jobs.ts",
    "cf:check": "bun x vinext@1.0.0-beta.8 check",
    "cf:build": "vinext build",
    "build:cf": "vinext build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@better-auth/passkey": "^1.6.26",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.3",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "vinext": "^1.0.0-beta.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  }
